# CNN Classifier Backend Configuration
# Copy to .env and modify as needed

# Server
PORT=8000

# Model paths (relative to backend directory)
MODEL_PATH=models/cifar10_cnn.pth
LABELS_PATH=models/labels.json

# Device: cpu, cuda, or mps (Apple Silicon)
DEVICE=cpu

# Model input size: height,width,channels (CIFAR-10 is 32x32x3)
INPUT_SIZE=32,32,3

# Data loading
BATCH_SIZE=32
NUM_WORKERS=4

# Reproducibility
SEED=42