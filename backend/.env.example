# CNN Classifier Backend Configuration
# Copy to .env and modify as needed
# All variables must use CNN_ prefix (e.g., CNN_PORT=8000)

# Server
CNN_PORT=8000

# Model paths (relative paths anchor to the project root)
CNN_MODEL_PATH=checkpoints/best_model.pt
CNN_LABELS_PATH=checkpoints/labels.json

# Device: cpu, cuda, mps, or auto (auto-detects best available)
CNN_DEVICE=auto

# Model input size: height,width (CIFAR-10 is 32x32)
CNN_INPUT_SIZE=32,32

# Data loading
CNN_BATCH_SIZE=64
CNN_NUM_WORKERS=4

# Reproducibility
CNN_SEED=42
